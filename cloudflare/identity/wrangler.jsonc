{
  "name": "factorypulse-identity",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "durable_objects": {"bindings":[{"name":"IDENTITY_RUNTIME","class_name":"IdentityRuntime"},{"name":"BUSINESS_RESULTS","class_name":"BusinessResults"}]},
  "migrations": [{"tag":"identity-runtime-v1","new_sqlite_classes":["IdentityRuntime"]},{"tag":"business-results-v1","new_sqlite_classes":["BusinessResults"]}],
  "d1_databases": [{"binding":"DB","database_name":"factorypulse_users","database_id":"af5776ef-c7f8-48c7-8f21-1bb36f98061c"}],
  "vars": {"ALLOWED_ORIGINS":"https://observl.github.io,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000"}
}
